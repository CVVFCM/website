{
    "name": "cvvfcm/site-v4",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-imagick": "*",
        "api-platform/core": "^4.3",
        "cmsig/seal": "^0.12.3",
        "cmsig/seal-loupe-adapter": "^0.12.2",
        "doctrine/doctrine-bundle": "^2.18.1",
        "doctrine/doctrine-fixtures-bundle": "^4.3.0",
        "doctrine/doctrine-migrations-bundle": "*",
        "friendsofsymfony/http-cache-bundle": "^3.0",
        "league/commonmark": "^2.8",
        "league/flysystem-async-aws-s3": "*",
        "league/flysystem-bundle": "^3.3",
        "scheb/2fa-bundle": "^7.11.0",
        "scheb/2fa-email": "^7.11.0",
        "scheb/2fa-trusted-device": "^7.11.0",
        "scienta/doctrine-json-functions": "^6.3",
        "stof/doctrine-extensions-bundle": "^1.14.0",
        "sulu/form-bundle": "^3.0.0",
        "sulu/sulu": "^3.0.7",
        "symfony/ai-agent": "^0.10.0",
        "symfony/ai-bundle": "^0.10.0",
        "symfony/ai-chat": "^0.10",
        "symfony/ai-gemini-platform": "^0.10.0",
        "symfony/ai-mistral-platform": "^0.10.0",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/brevo-mailer": "^7.4",
        "symfony/config": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.9.0",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/google-chat-notifier": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/messenger": "7.4.*",
        "symfony/monolog-bridge": "7.4.*",
        "symfony/monolog-bundle": "^3.10.0",
        "symfony/notifier": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/scheduler": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/stimulus-bundle": "^2.31.0",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-leaflet-map": "^2.31.0",
        "symfony/ux-live-component": "^2.31",
        "symfony/ux-map": "^2.21.0",
        "symfony/ux-turbo": "^2.31",
        "symfony/ux-twig-component": "^2.31.0",
        "twig/extra-bundle": "^3.24",
        "twig/intl-extra": "^3.22.0",
        "twig/markdown-extra": "^3.28",
        "twig/twig": "^3.22.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpunit/phpunit": "^12.4.2",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/error-handler": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*",
        "vimeo/psalm": "*",
        "vincentlanglet/twig-cs-fixer": "^3.10"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php85": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "bin/websiteconsole cache:clear": "php-script",
            "bin/adminconsole sulu:media:init": "php-script",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "minimal-reset": [
            "php bin/console doctrine:schema:drop --force --full-database",
            "php bin/console doctrine:schema:create",
            "php bin/console cmsig:seal:index-drop --force",
            "php bin/console cmsig:seal:index-create",
            "php bin/console sulu:security:role:create admin Sulu",
            "php bin/console sulu:security:user:create admin Adam Ministrator admin@example.com fr admin !ChangeMe!",
            "php bin/console sulu:security:init",
            "php bin/console sulu:page:initialize",
            "php bin/console sulu:form:generate-form",
            "php bin/console doctrine:fixtures:load --no-interaction --append",
            "php bin/console cmsig:seal:reindex"
        ],
        "reset": [
            "composer minimal-reset",
            "php bin/console app:import:live-weather-csv",
            "php bin/console app:import:weather-forecast-csv"
        ],
        "reset-test": [
            "php bin/console -etest doctrine:database:create --if-not-exists",
            "php bin/console -etest doctrine:schema:drop --force --full-database",
            "php bin/console -etest doctrine:schema:create",
            "php bin/console -etest cmsig:seal:index-drop --force",
            "php bin/console -etest cmsig:seal:index-create",
            "php bin/console -etest sulu:security:role:create admin Sulu",
            "php bin/console -etest sulu:security:user:create admin Adam Ministrator admin@example.com fr admin !ChangeMe!",
            "php bin/console -etest sulu:security:init",
            "php bin/console -etest sulu:page:initialize",
            "php bin/console -etest sulu:form:generate-form",
            "php bin/console -etest doctrine:fixtures:load --no-interaction --append",
            "php bin/console -etest cmsig:seal:reindex",
            "php bin/console -etest app:import:live-weather-csv",
            "php bin/console -etest app:import:weather-forecast-csv"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*"
        }
    }
}
