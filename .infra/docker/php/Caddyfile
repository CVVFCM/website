{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	admin localhost:2019
	metrics
}

{$CADDY_EXTRA_CONFIG}

php:80, localhost:80, {$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}

		format console
	}

	reverse_proxy /stream/* rtsp-to-web:8083

	root /app/public
	encode zstd br gzip

	@phpRoute {
		not file {path}
		not path /.well-known/mercure*
		not path /stream/*
	}
	rewrite @phpRoute index.php

	@frontController path index.php
	php @frontController {
		{$FRANKENPHP_SITE_CONFIG}

		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}

	# AssetMapper compiles every file under /assets/ with a content digest in its name, so the URL
	# changes whenever the content does — they are safe to cache forever (immutable).
	@immutableAssets path /assets/*
	header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

	# Sulu writes resized/format images to public/uploads/media once generated, then Caddy serves them
	# statically (PHP bypassed). Their URLs carry ?v={version}-{subVersion}, which bumps on re-upload or
	# re-crop, so a cached file is safe forever. The `file` condition scopes this to images that exist on
	# disk, so a missing format (404, served by PHP) is never cached as immutable.
	@resizedMedia {
		path /uploads/media/*
		file
	}
	header @resizedMedia Cache-Control "public, max-age=31536000, immutable"

	file_server {
		hide *.php
	}

	{$SITE_EXTRA_CONFIG}
}
