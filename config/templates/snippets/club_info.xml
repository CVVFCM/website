<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>club_info</key>

    <meta>
        <title lang="fr">Informations du club</title>
    </meta>

    <areas>
        <area key="club_info">
            <meta>
                <title lang="fr">Informations du club</title>
            </meta>
        </area>
    </areas>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta><title lang="fr">Titre (interne)</title></meta>
            <tag name="sulu.node.name"/>
        </property>

        <property name="address" type="text_area">
            <meta><title lang="fr">Adresse</title></meta>
        </property>

        <property name="legal_status" type="text_line">
            <meta><title lang="fr">Statut juridique</title></meta>
        </property>

        <property name="siret" type="text_line">
            <meta><title lang="fr">SIRET</title></meta>
        </property>

        <block name="labels" default-type="label">
            <meta><title lang="fr">Labels / Certifications</title></meta>
            <types>
                <type name="label">
                    <meta><title lang="fr">Label</title></meta>
                    <properties>
                        <property name="name" type="text_line" mandatory="true">
                            <meta><title lang="fr">Nom</title></meta>
                        </property>
                        <property name="logo" type="single_media_selection" mandatory="true">
                            <meta><title lang="fr">Logo</title></meta>
                        </property>
                        <property name="url" type="url">
                            <meta><title lang="fr">Lien</title></meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>

        <block name="legal_links" default-type="legal">
            <meta><title lang="fr">Liens légaux (bas de page)</title></meta>
            <types>
                <type name="legal">
                    <meta><title lang="fr">Lien légal</title></meta>
                    <properties>
                        <property name="label" type="text_line" mandatory="true">
                            <meta><title lang="fr">Libellé</title></meta>
                        </property>
                        <property name="page" type="single_page_selection" mandatory="true">
                            <meta><title lang="fr">Page</title></meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>

        <property name="col1_title" type="text_line">
            <meta><title lang="fr">Colonne 1 — Titre</title></meta>
        </property>

        <block name="col1_links" default-type="link">
            <meta><title lang="fr">Colonne 1 — Liens</title></meta>
            <types>
                <type name="link">
                    <meta><title lang="fr">Lien</title></meta>
                    <properties>
                        <property name="label" type="text_line" mandatory="true">
                            <meta><title lang="fr">Libellé</title></meta>
                        </property>
                        <property name="page" type="single_page_selection" mandatory="true">
                            <meta><title lang="fr">Page</title></meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>

        <property name="col2_title" type="text_line">
            <meta><title lang="fr">Colonne 2 — Titre</title></meta>
        </property>

        <block name="col2_links" default-type="link">
            <meta><title lang="fr">Colonne 2 — Liens</title></meta>
            <types>
                <type name="link">
                    <meta><title lang="fr">Lien</title></meta>
                    <properties>
                        <property name="label" type="text_line" mandatory="true">
                            <meta><title lang="fr">Libellé</title></meta>
                        </property>
                        <property name="page" type="single_page_selection" mandatory="true">
                            <meta><title lang="fr">Page</title></meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>
    </properties>
</template>
