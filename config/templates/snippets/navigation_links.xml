<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>navigation_links</key>

    <meta>
        <title lang="fr">Liens de navigation</title>
    </meta>

    <areas>
        <area key="navigation_links">
            <meta>
                <title lang="fr">Liens de navigation</title>
            </meta>
        </area>
    </areas>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta>
                <title lang="fr">Titre</title>
            </meta>
            <tag name="sulu.node.name"/>
        </property>

        <block name="links" default-type="internal">
            <meta>
                <title lang="fr">Nœuds de navigation</title>
            </meta>

            <types>
                <type name="internal">
                    <meta>
                        <title lang="fr">Page interne</title>
                    </meta>
                    <properties>
                        <property name="label" type="text_line" mandatory="true">
                            <meta>
                                <title lang="fr">Libellé</title>
                            </meta>
                        </property>
                        <property name="page" type="single_page_selection" mandatory="true">
                            <meta>
                                <title lang="fr">Page</title>
                            </meta>
                        </property>
                        <property name="media" type="single_media_selection">
                            <meta>
                                <title lang="fr">Média</title>
                            </meta>
                        </property>
                    </properties>
                </type>

                <type name="external">
                    <meta>
                        <title lang="fr">Lien externe</title>
                    </meta>
                    <properties>
                        <property name="label" type="text_line" mandatory="true">
                            <meta>
                                <title lang="fr">Libellé</title>
                            </meta>
                        </property>
                        <property name="url" type="url" mandatory="true">
                            <meta>
                                <title lang="fr">URL</title>
                            </meta>
                        </property>
                        <property name="media" type="single_media_selection">
                            <meta>
                                <title lang="fr">Média</title>
                            </meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>
    </properties>
</template>
