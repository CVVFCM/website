        <property name="windDirectionGapForecast" visibility="yes" searchability="no" translation="Écart direction / prévision (°)">
            <field-name>windDirectionGapForecast</field-name>
            <entity-name>App\Entity\LiveWeatherRecord</entity-name>
        </property>

        <property name="windSpeedGapModel" visibility="yes" searchability="no" translation="Écart vitesse / modèle (%)">
            <field-name>windSpeedGapModel</field-name>
            <entity-name>App\Entity\LiveWeatherRecord</entity-name>
        </property>

        <property name="windDirectionGapModel" visibility="yes" searchability="no" translation="Écart direction / modèle (°)">
            <field-name>windDirectionGapModel</field-name>
            <entity-name>App\Entity\LiveWeatherRecord</entity-name>
        </property>
    </properties>
