{% types {
    status_code: 'int',
    status_text: 'string',
    home_path?: 'string',
} %}
{# Rendu par le ErrorController de Sulu : seules status_code, status_text et
   exception sont disponibles — pas de `resource`, donc pas de fil d'Ariane.
   home_path est optionnel pour permettre un rendu hors requête (tests). #}
<header class="Page__header">
    {{ include('partials/logo_topbar.html.twig') }}
    <div class="Page__headerMain">
        <div class="Page__headerBody">
            <p class="ErrorPage__kicker">Erreur {{ status_code }}</p>
            {% if status_code == 404 %}
                <h1 class="Page__headerTitle">Page introuvable</h1>
                <div class="Page__headerDescription">
                    <p class="ErrorPage__quip">Problème de navigation ? Il ne fallait pas louper les cours…</p>
                    <p>La page que vous cherchez a peut-être été déplacée, renommée, ou n'a jamais existé.</p>
                </div>
            {% else %}
                <h1 class="Page__headerTitle">Une erreur est survenue</h1>
                <div class="Page__headerDescription">
                    <p>Le site a rencontré un problème inattendu (code {{ status_code }}). Réessayez dans quelques instants.</p>
                </div>
            {% endif %}
        </div>
        {% if status_code == 404 %}
            {# Picto « carte marine trouée » : le voilier suit une route tracée droit
               dans un trou de la carte. Décoratif — le message porte le sens. #}
            <div class="ErrorPage__illustration" aria-hidden="true">
                <svg viewBox="0 0 200 200" role="img" focusable="false">
                    <circle cx="100" cy="100" r="96" fill="#FF512D" />
                    <g transform="rotate(-7 100 100)">
                        <rect x="30" y="46" width="140" height="110" rx="5" fill="#FFFFFF" />
                        {# Courbes bathymétriques #}
                        <path d="M40 140 q 14 -18 34 -12 q 17 5 15 19" fill="none" stroke="#01529B" stroke-width="2" stroke-linecap="round" />
                        <path d="M40 124 q 18 -20 42 -12" fill="none" stroke="#01529B" stroke-width="2" stroke-linecap="round" />
                        {# Sondes #}
                        <circle cx="58" cy="66" r="1.8" fill="#01529B" />
                        <circle cx="74" cy="82" r="1.8" fill="#01529B" />
                        <circle cx="52" cy="96" r="1.8" fill="#01529B" />
                        <circle cx="152" cy="140" r="1.8" fill="#01529B" />
                        {# Rose des vents #}
                        <g transform="translate(148 68)">
                            <circle r="9" fill="none" stroke="#01529B" stroke-width="2" />
                            <path d="M0 -13 L3 0 L0 13 L-3 0 Z" fill="#01529B" />
                            <path d="M-13 0 L0 -3 L13 0 L0 3 Z" fill="#01529B" />
                        </g>
                        {# Route tracée… droit dans le trou #}
                        <path d="M36 106 C 58 94, 78 118, 96 114" fill="none" stroke="#01529B" stroke-width="2" stroke-dasharray="5 5" stroke-linecap="round" />
                        {# Trou déchiré #}
                        <path d="M96 114 l 8 -11 9 5 3 -9 9 2 6 -6 5 9 10 1 -4 9 7 8 -10 6 1 9 -11 -2 -6 7 -8 -7 -10 3 -4 -9 -9 -2 4 -13 Z" fill="#FF512D" />
                        {# Dériveur qui bascule dans le trou (style du picto EFV) #}
                        <g transform="translate(118 102)">
                            <g class="ErrorPage__boat" transform="rotate(38)">
                                <path d="M-1 -26 C 8 -18 12 -8 10 2 L 0 2 Z" fill="#BFF0FB" />
                                <path d="M-3 -26 L -3 2 L -14 2 C -13 -10 -9 -19 -3 -26 Z" fill="#FFFFFF" stroke="#01529B" stroke-width="1" />
                                <path d="M-17 6 L 13 6 L 8 13 L -12 13 Z" fill="#01529B" />
                            </g>
                        </g>
                    </g>
                </svg>
            </div>
        {% endif %}
    </div>
</header>
<section class="ErrorPage__actions SectionPadded" aria-label="Où aller ensuite">
    <a class="CallToAction--btn" href="{{ home_path|default('/') }}">Retour à l'accueil</a>
    <nav class="ErrorPage__links" aria-label="Pages utiles">
        <a class="ErrorPage__link" href="/evenements">Événements</a>
        <a class="ErrorPage__link" href="/contact">Contact</a>
    </nav>
</section>
