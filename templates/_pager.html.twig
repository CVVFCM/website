<ul class="Pager">
    {% set page = list_view.page %}

    {% if page - 1 >= 1 %}
        <li class="Pager__item Pager__item--previous">
            <a class="Pager__link" href="{{ sulu_content_path(content.url) }}?p={{ page - 1 }}">&laquo;</a>
        </li>
    {% endif %}

    {# Twig ranges count downwards when maxPage < 1 (e.g. "1..0" yields [1, 0] with no results). #}
    {% for i in 1..max(list_view.maxPage, 1) %}
        <li class="Pager__item{% if list_view.page == i %} Pager__item--current{% endif %}">
            <a class="Pager__link{% if list_view.page == i %} Pager__link--active{% endif %}" href="{{ sulu_content_path(content.url) }}?p={{ i }}">{{ i }}</a>
        </li>
    {% endfor %}

    {% if list_view.hasNextPage %}
        <li class="Pager__item Pager__item--next">
            <a class="Pager__link" href="{{ sulu_content_path(content.url) }}?p={{ page + 1 }}">&raquo;</a>
        </li>
    {% endif %}
</ul>
