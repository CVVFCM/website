{# Autonomous page by default; ?embedded renders only the content block for the
   site-wide side pane (see forgie_launcher_controller.js). #}
{% extends app.request.query.has('embedded') ? 'forgie/embedded_base.html.twig' : 'base.html.twig' %}

{% set page_title = 'Forgie — CVVFCM' %}

{% block importmap %}{{ importmap(['app', 'forgie']) }}{% endblock %}

{# Event-page top bar instead of the main navigation: Forgie is a full-height standalone page. #}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{# No floating launcher on the standalone Forgie page — it IS Forgie. #}
{% block forgie_launcher %}{% endblock %}

{% block pageclass %}Forgie-page{% endblock %}

{% block content %}
    <section
        class="Forgie"
        data-controller="forgie-chat"
        data-forgie-chat-hub-url-value="{{ hub_url }}"
    >
        <header class="Forgie__header">
            <div class="Logo__headerTopBar Forgie__topBar">
                <a class="Logo__headerLogoLink" href="/" aria-label="Accueil CVVFCM">
                    <img class="Logo__headerLogoImg" src="{{ asset('images/logo_cvvfcm.svg') }}" alt="Logo CVVFCM" />
                    <span class="Logo__headerLogoText">Club de Voile<br />des Vieilles Forges<br />de Charleville-Mézières</span>
                </a>
            </div>

            <div class="Forgie__hero">
                <h1 class="Forgie__title">Forgie</h1>
                <p class="Forgie__subtitle">L'assistant du club — météo, régates, sorties&nbsp;: pose ta question.</p>
            </div>
        </header>

        <div class="Forgie__messages" data-forgie-chat-target="messages" aria-live="polite">
            <div class="Forgie__welcome">
                <img class="Forgie__welcomeLogo" src="{{ asset('images/logo_cvvfcm.svg') }}" alt="" />
                <p class="Forgie__welcomeText">Bonjour moussaillon&nbsp;! Quel temps sur le lac, quelles régates à venir&nbsp;?<br />Je suis là pour ça.</p>
            </div>
        </div>

        <div class="Forgie__preview" data-forgie-chat-target="preview" hidden></div>

        <form class="Forgie__form" data-action="submit->forgie-chat#send">
            <input
                type="file"
                accept="image/png,image/jpeg,image/webp,image/gif"
                hidden
                data-forgie-chat-target="file"
                data-action="change->forgie-chat#fileSelected"
            />
            <button
                class="Forgie__attach"
                type="button"
                aria-label="Joindre une image"
                title="Joindre une image"
                data-action="forgie-chat#pickFile"
            >📎</button>
            <input
                class="Forgie__input"
                type="text"
                name="message"
                placeholder="Écris ton message…"
                maxlength="4000"
                autocomplete="off"
                data-forgie-chat-target="input"
            />
            <button class="Forgie__submit" type="submit" data-forgie-chat-target="submit">Envoyer</button>
        </form>
    </section>
{% endblock %}
