<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {% block meta %}
        {{ include('@SuluWebsite/Extension/seo.html.twig', {
            seo: extension.seo|default([]),
            content: content|default([]),
            localizations: localizations|default([]),
            shadowBaseLocale: shadowBaseLocale|default(),
        }) }}
    {% endblock %}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" />

    {% block styles '' %}

    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
<body>
    <header class="SiteHeader">
        {% block header %}
            {{ include('_main_navigation.html.twig') }}
        {% endblock %}
    </header>

    <main class="Main__container {% block pageclass '' %}">
        {% block content %}{% endblock %}
    </main>

    <footer>
        {% block footer %}
            {{ include('_footer_navigation.html.twig') }}
        {% endblock %}
    </footer>

    {% block forgie_launcher %}
        <a class="ForgieLauncher"
           href="{{ path('forgie') }}"
           title="Forgie, l'assistant du club"
           data-controller="forgie-launcher"
           data-action="forgie-launcher#open:prevent keydown.esc@window->forgie-launcher#close"
        >
            {# Picto Forgie : bulle de chat, bateau du logo CVVFCM en réserve (tracés du logo verbatim). #}
            <svg viewBox="0 0 100 100" aria-hidden="true">
                <defs>
                    <mask id="forgie-launcher-sails">
                        <rect width="100" height="100" fill="#fff" />
                        <g fill="#000" transform="translate(-16.3 10) scale(0.44)">
                            <path transform="translate(49.519 -8.254)" d="M101.557,8.33V143.413H43S47.178,87.906,78.573,14.9c3.378-7.848,22.984-6.572,22.984-6.572" />
                            <path transform="translate(82.271 2.931)" d="M72.441,130.7V19.683L128.151,130.7Z" />
                            <path transform="translate(-5287.191 -8619.691)" d="M5494.167,8738.647l-49.066-97.773c7.155,2.267,20.938,7.6,32.882,17.868,9.907,8.513,16.592,18.7,19.868,30.288a66.691,66.691,0,0,1,2.23,22.131,100.924,100.924,0,0,1-5.914,27.483Z" />
                        </g>
                    </mask>
                </defs>
                <path fill="currentColor" mask="url(#forgie-launcher-sails)" d="M24 4 H76 C87 4 96 13 96 24 V58 C96 69 87 78 76 78 H44 L20 95 L26 78 H24 C13 78 4 69 4 58 V24 C4 13 13 4 24 4 Z" />
            </svg>
            <span class="ForgieLauncher__label">Ouvrir Forgie, l'assistant du club</span>
        </a>
    {% endblock %}
</body>
</html>
