{#
  Breadcrumb for a page: home icon first, then the ancestor pages (current page excluded).

  Params:
    uuid  page uuid (resource.uuid)
#}
<ul class="BreadCrumb" aria-label="Fil d'Ariane">
    {% for item in sulu_page_breadcrumb(uuid)|slice(0, -1) %}
        <li>
            <a href="{{ sulu_content_path(item.url) }}">
                {% if loop.first %}
                    {# The homepage title is the full club name — far too long for a breadcrumb. #}
                    <svg class="BreadCrumb__homeIcon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3.1 2.6 11l1.3 1.5L5 11.6V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-8.4l1.1.9 1.3-1.5L12 3.1z"/></svg>
                    <span class="BreadCrumb__srOnly">Accueil</span>
                {% else %}
                    {{ item.title }}
                {% endif %}
            </a>
        </li>
    {% endfor %}
</ul>
