{% types {
    event: 'array<string, mixed>',
    featured?: 'bool',
} %}
{% import 'partials/_picture.html.twig' as picture %}
{% set daysRemaining = (event.begin_date|date('U') - 'now'|date('U')) // 86400 %}
<article class="EventCard{{ featured is defined and featured ? ' EventCard--featured' : '' }}">
    <div class="EventCard__image">
        {% if event.main_media is defined and event.main_media %}
            {{ picture.render(event.main_media, 'sulu-170x170', event.main_media.title, {
                loading: 'lazy',
                width: 170,
                height: 170,
            }) }}
        {% else %}
            {# Type-specific default illustration when the event has no media. #}
            {% set defaultEventImages = {regatta: 'regatta', stage: 'stage'} %}
            <img src="{{ asset('images/events/' ~ defaultEventImages[event.event_type|default('default')]|default('default') ~ '.jpg') }}" alt="" width="170" height="170" loading="lazy" />
        {% endif %}
    </div>
    <div class="EventCard__content">
        <div class="EventCard__meta">
            <span class="EventCard__countdown">J-{{ daysRemaining }}</span>
            <span class="EventCard__type">{{ event.event_type|default(null)|event_type_label }}</span>
        </div>
        <h3 class="EventCard__title">
            <a href="{{ event.url }}" class="EventCard__link">{{ event.title }}</a>
        </h3>
        {% set end_date = event.end_date|default(null) %}
        <time class="EventCard__date" datetime="{{ event.begin_date|date('Y-m-d') }}">
            {% if end_date is empty or event.begin_date|date('Y-m-d') == end_date|date('Y-m-d') %}
                {{ event.begin_date|format_date(pattern: 'd MMMM Y', locale: 'fr')|upper }}
            {% elseif event.begin_date|date('Y-m') == end_date|date('Y-m') %}
                {{ event.begin_date|format_date(pattern: 'd', locale: 'fr') }}–{{ end_date|format_date(pattern: 'd MMMM Y', locale: 'fr')|upper }}
            {% elseif event.begin_date|date('Y') == end_date|date('Y') %}
                {{ event.begin_date|format_date(pattern: 'd MMMM', locale: 'fr')|upper }} – {{ end_date|format_date(pattern: 'd MMMM Y', locale: 'fr')|upper }}
            {% else %}
                {{ event.begin_date|format_date(pattern: 'd MMMM Y', locale: 'fr')|upper }} – {{ end_date|format_date(pattern: 'd MMMM Y', locale: 'fr')|upper }}
            {% endif %}
        </time>
        <span class="EventCard__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
            </svg>
        </span>
    </div>
</article>
