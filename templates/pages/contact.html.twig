{% extends 'base.html.twig' %}

{% block styles %}
    <link rel="stylesheet" href="{{ asset('styles/contact.css') }}" />
{% endblock %}

{% block content %}
    <article>
        <header>
            <h1>{{ content.title }}</h1>
            {% if content.media %}
                <div>
                    <img
                        src="{{ content.media.formats['sulu-400x400.webp'] }}"
                        alt="{{ content.media.title }}"
                        title="{{ content.media.description|default(content.media.title) }}" />
                </div>
            {% endif %}

            <div>{{ content.description|raw }}</div>
        </header>

        <section>
            {{ form(form) }}
        </section>
    </article>
{% endblock %}
