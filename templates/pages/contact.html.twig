{% extends 'base.html.twig' %}

{% block styles %}
    <link rel="stylesheet" href="{{ asset('styles/contact.css') }}" />
{% endblock %}

{% block content %}
    {# Import inside the block: Sulu preview renders blocks in isolation (renderBlock), so
       top-level imports never execute there. #}
    {% import 'partials/_picture.html.twig' as picture %}
    <article>
        <header>
            <h1>{{ content.title }}</h1>
            {% if content.media %}
                <div>
                    {{ picture.render(content.media, 'sulu-400x400', content.media.title, {
                        loading: 'eager',
                        title: content.media.description|default(content.media.title),
                        width: 400,
                        height: 400,
                    }) }}
                </div>
            {% endif %}

            <div>{{ content.description|raw }}</div>
        </header>

        <section>
            {{ form(form) }}
        </section>
    </article>
{% endblock %}
