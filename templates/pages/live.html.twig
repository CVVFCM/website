{% extends 'base.html.twig' %}

{% block styles %}
    <link rel="stylesheet" href="{{ asset('styles/live.css') }}" />
{% endblock %}

{% block content %}
    <article class="LivePage">
        <header class="LivePage__header">
            <h1>{{ content.title }}</h1>
            {% if content.media %}
                <div>

                    <img
                        src="{{ content.media.formats['sulu-400x400.webp'] }}"
                        alt="{{ content.media.title }}"
                        title="{{ content.media.description|default(content.media.title) }}" />
                </div>
            {% endif %}

            <div>{{ content.description|raw }}</div>
        </header>

        <section class="LivePage__webcams">
            {% for webcam_block in content.webcams %}
                <twig:Webcam class="LivePage__webcam" url="{{ webcam_block.webcam_stream_url }}" />
            {% endfor %}
        </section>

        <section class="LivePage__weather" id="WeatherLive">
            <twig:WeatherLive full="true" />
        </section>
    </article>
{% endblock %}
