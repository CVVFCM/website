{% extends 'base.html.twig' %}

{% block content %}
    <h1>{{ content.title }}</h1>

    {{ content.article|raw }}

    {% if content.form %}
        {% set form = sulu_form_build(content.form, 'page', resource.id) %}

        {% form_theme form '@SuluForm/themes/basic.html.twig' %}
        {{ form(form) }}
    {% endif %}
{% endblock %}
