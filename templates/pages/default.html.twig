{% extends 'base.html.twig' %}

{% block pageclass 'DefaultPage' %}

{% block styles %}
    <link rel="stylesheet" href="{{ asset('styles/default.css') }}" />
{% endblock %}

{% block content %}
    <header class="Page__header">
        {{ include('partials/logo_topbar.html.twig') }}
        {% block pageHeader %}
        {# Import inside the block: Sulu preview renders blocks in isolation (renderBlock), so
           top-level imports never execute there. #}
        {% import 'partials/_picture.html.twig' as picture %}
        <div class="Page__headerMain">
            <div class="Page__headerBody">
                 <div class="Page__headerNav">
                    {{ include('partials/_breadcrumb.html.twig', {uuid: resource.uuid}, with_context: false) }}
                </div>
                <h1 class="Page__headerTitle">{{ content.title }}</h1>
                    {% if content.description is defined %}
                        <div class="Page__headerDescription">{{ content.description|raw }}</div>
                    {% endif %}
            </div>
            {% if content.media %}
                <div class="Page__headerMedia">
                    {{ picture.render(content.media, 'x800', content.media.title, {
                        class: 'Page__headerImage',
                        loading: 'eager',
                        title: content.media.description|default(content.media.title),
                    }) }}
                </div>
            {% endif %}
        </div>
        {% endblock %}
    </header>
    {% block MainContent %}
        {% import 'partials/_picture.html.twig' as picture %}
        {% if content.blocks is defined and content.blocks is not empty %}
            <div class="DefaultPage__blocks">
                {% for block in content.blocks %}
                    {% if block.type == 'title_image_text' %}
                        {{ include('partials/_content_block_title_image_text.html.twig', {block: block}, with_context: false) }}

                    {% elseif block.type == 'gallery' %}
                        <div class="ContentBlock ContentBlock--gallery SectionPadded">
                            {{ include('partials/_media_mosaic.html.twig', {medias: block.medias}, with_context: false) }}
                        </div>

                    {% elseif block.type == 'list' %}
                        <article class="ContentBlock ContentBlock--list SectionPadded">
                            <header class="ContentBlock__header">
                                <h2 class="ContentBlock__title">{{ block.title }}</h2>
                                {% if block.description %}
                                    <div class="ContentBlock__description">{{ block.description|raw }}</div>
                                {% endif %}
                            </header>
                            {% if block.pages is defined and block.pages is not empty %}
                                <ul class="ListPage__list ListPage__list--page SectionPadded">
                                    {% for item in block.pages %}
                                        <li class="ListPage__listItem">
                                            {% if item.event_type is defined and item.event_type %}
                                                {{ include('partials/list_item_event.html.twig', {item: item}, with_context: false) }}
                                            {% else %}
                                                {{ include('partials/list_item_page.html.twig', {item: item}, with_context: false) }}
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}

                        </article>

                    {% elseif block.type == 'cta' %}
                        <div class="ContentBlock ContentBlock--cta SectionPadded">
                            <h2 class="ContentBlock__title">{{ block.title }}</h2>
                            <div class="ContentBlock__description">{{ block.description|raw }}</div>
                            {% if block.cta_url and block.cta_label %}
                                <a class="ContentBlock__cta CallToAction--btn" href="{{ block.cta_url }}">{{ block.cta_label }}</a>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    {% endblock %}

    {% if content.form is defined and content.form %}
        {% set club_info = sulu_snippet_load_by_area('club_info') %}
        <section class="FormSection SectionPadded">
            <div class="FormSection__grid{{ club_info ? ' FormSection__grid--withAside' : '' }}">
                <div class="FormSection__card FormSection__card--form DynamicForm">
                    {% if app.request.get('send') == 'true' %}
                        {# The form bundle redirects here after a successful submission. #}
                        <div class="DynamicForm__success">
                            {{ view.form.entity.successText|default('<p>Votre message a bien été envoyé.</p>')|raw }}
                        </div>
                    {% else %}
                        {% set form = content.form %}

                        {% form_theme form 'forms/dynamic_form_theme.html.twig' %}
                        {{ form(form) }}
                    {% endif %}
                </div>

                {% if club_info %}
                    <aside class="FormSection__aside" aria-label="Coordonnées du club">
                        <div class="FormSection__card FormSection__card--info">
                            <h2 class="FormSection__cardTitle">Nos coordonnées</h2>
                            {% if club_info.content.address is defined and club_info.content.address %}
                                <address class="FormSection__address">{{ club_info.content.address|nl2br }}</address>
                            {% endif %}
                            {% if club_info.content.email is defined and club_info.content.email %}
                                <a class="FormSection__contactLink" href="mailto:{{ club_info.content.email }}">{{ club_info.content.email }}</a>
                            {% endif %}
                            {% if club_info.content.phone is defined and club_info.content.phone %}
                                <a class="FormSection__contactLink" href="tel:{{ club_info.content.phone|replace({' ': ''}) }}">{{ club_info.content.phone }}</a>
                            {% endif %}
                            {% if club_info.content.legal_status is defined and club_info.content.legal_status %}
                                <p class="FormSection__legal">{{ club_info.content.legal_status }}</p>
                            {% endif %}
                        </div>

                        {% if club_info.content.location is defined and club_info.content.location %}
                            <div class="FormSection__card FormSection__card--map">
                                <h2 class="FormSection__cardTitle">Nous trouver</h2>
                                <div class="FormSection__map">
                                    <twig:Map
                                        latitude="{{ club_info.content.location.lat }}"
                                        longitude="{{ club_info.content.location.long }}"
                                        title="{{ club_info.content.location.title }}"
                                        zoom="{{ club_info.content.location.zoom }}"
                                        style="height: 100%; width: 100%;"
                                    />
                                </div>
                            </div>
                        {% endif %}
                    </aside>
                {% endif %}
            </div>
        </section>
    {% endif %}
{% endblock %}
