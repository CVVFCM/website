{% extends 'base.html.twig' %}

{% block structured_data %}
    {{ parent() }}
    {% set event_place = {
        '@type': 'Place',
        name: content.location.title|default('Lac des Vieilles Forges'),
        geo: {
            '@type': 'GeoCoordinates',
            latitude: content.location.lat|default(49.8712),
            longitude: content.location.long|default(4.5947),
        },
    } %}
    <script type="application/ld+json">
    {{- {
        '@context': 'https://schema.org',
        '@type': 'Event',
        name: content.title,
        startDate: content.begin_date|date('c'),
        endDate: (content.end_date ?? content.begin_date)|date('c'),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        url: app.request.uri,
        location: event_place,
        image: content.main_media ? app.request.schemeAndHttpHost ~ content.main_media.thumbnails['sulu-400x400'] : null,
        organizer: {'@type': 'Organization', name: 'CVVFCM', url: app.request.schemeAndHttpHost ~ sulu_content_root_path()},
    }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}
    </script>
{% endblock %}

{% block pageclass 'EventPage' %}

{% block styles %}
    <link rel="stylesheet" href="{{ asset('styles/event.css') }}" />
{% endblock %}

{% block content %}
    {# Import inside the block: Sulu preview renders blocks in isolation (renderBlock), so
       top-level imports never execute there. #}
    {% import 'partials/_picture.html.twig' as picture %}

    {% set days_diff = ((content.begin_date|date('U') - 'now'|date('U')) / 86400)|round(0, 'floor') %}

    <header class="EventPage__header">

        {{ include('partials/logo_topbar.html.twig') }}

        <div class="EventPage__headerMain">
             <div class="EventPage__headerNav">
                {{ include('partials/_breadcrumb.html.twig', {uuid: resource.uuid}, with_context: false) }}
            </div>

            {% if content.main_media %}
                <div class="EventPage__headerImageWrapper" aria-hidden="true">
                    {{ picture.render(content.main_media, 'sulu-400x400', content.main_media.title, {
                        class: 'EventPage__headerImage',
                        loading: 'eager',
                        title: content.main_media.description|default(content.main_media.title),
                        width: 400,
                        height: 400,
                    }) }}
                </div>
            {% endif %}

            <div class="EventPage__headerBody">

                <div class="EventPage__headerMeta">
                    {% if days_diff > 0 %}
                        <span class="EventPage__headerCountdown">J-{{ days_diff }}</span>
                    {% endif %}
                    {% if content.event_type %}
                        <span class="EventPage__headerType">{{ content.event_type|event_type_label|upper }}</span>
                    {% endif %}
                </div>

                <h1 class="EventPage__headerTitle">{{ content.title }}</h1>

                {{ include('partials/event_page_dates.html.twig', {
                    begin_date: content.begin_date,
                    end_date: content.end_date,
                }, with_context: false) }}
            </div>
            <a class="EventPage__headerSaveDate" href="{{ path('event_ics', {uuid: resource.uuid}) }}" download>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Enregistrer la date
            </a>
            <div class="EventPage__headerDescription">

                {{ content.description|raw }}
            </div>
        </div>

    </header>
    <main class="EventPage__mainContent SectionPadded">
        {% if content.location %}
            <div class="EventPage__map EventContentBlock">
                <twig:Map
                    latitude="{{ content.location.lat }}"
                    longitude="{{ content.location.long }}"
                    title="{{ content.location.title }}"
                    zoom="{{ content.location.zoom }}"
                />
            </div>
        {% endif %}

        {% if content.series or content.services or content.regatta_informations or content.boats %}
            {% if content.boats %}
            <div class="EventPage__boatsBloc EventContentBlock">
                <h2 class="EventContentBlock__title">Bateaux</h2>
                <ul class="EventPage__boatsList">
                    {% for boat in content.boats %}
                        <li class="EventPage__boatItem">
                            <div class="EventPage__boatHeader">
                                <span class="EventPage__boatType">{{ boat.boat_type }}</span>
                                {% if boat.approximative_price %}
                                    <span class="EventPage__boatPrice">{{ boat.approximative_price }}</span>
                                {% endif %}
                                {% if boat.available_seats %}
                                    <span class="EventPage__boatSeats">{{ boat.available_seats }} place{{ boat.available_seats > 1 ? 's' }}</span>
                                {% endif %}
                            </div>
                            {% if boat.captain %}
                                <div class="EventPage__boatCaptains">
                                    {% for captain in boat.captain %}
                                        <div class="EventPage__boatCaptain">
                                            <span class="EventPage__boatCaptainLabel">Chef de bord</span>
                                            <span class="EventPage__boatCaptainName">{{ captain.fullName }}</span>
                                            {% if captain.contactDetails.emails[0] is defined %}
                                                <a class="EventPage__boatContactLink EventPage__boatContactLink--mail" href="mailto:{{ captain.contactDetails.emails[0].email }}">{{ captain.contactDetails.emails[0].email }}</a>
                                            {% endif %}
                                            {% if captain.contactDetails.phones[0] is defined %}
                                                <a class="EventPage__boatContactLink EventPage__boatContactLink--phone" href="tel:{{ captain.contactDetails.phones[0].phone }}">{{ captain.contactDetails.phones[0].phone }}</a>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            {% if content.series %}
            <div class="EventPage__seriesBloc EventContentBlock">
                <h2 class="EventContentBlock__title">Supports</h2>
                <ul class="EventPage__seriesList">
                    {% for series_with_rank in content.series %}
                        <li class="EventPage__seriesItem">
                            <span class="EventPage__seriesName">{{ series_with_rank.series }}</span>
                            <span class="EventPage__seriesRank">{{ series_with_rank.rank }}</span>
                        </li>
                    {% endfor %}
                </ul>
                {% if content.series_button_title or content.series_button_text %}
                    <div class="EventContentBlock__ctaSection">
                        {% if content.series_button_title %}
                            <h3 class="EventContentBlock__ctaTitle">{{ content.series_button_title }}</h3>
                        {% endif %}
                        {% if content.series_button_text %}
                            {% if content.series_button_url %}
                                <a class="EventContentBlock__ctaButton" href="{{ content.series_button_url }}">{{ content.series_button_text }}</a>
                            {% else %}
                                <span class="EventContentBlock__ctaButton EventContentBlock__ctaButton--disabled" aria-disabled="true">{{ content.series_button_text }}</span>
                            {% endif %}
                        {% endif %}
                    </div>
                {% endif %}
                {% if content.series_links %}
                    <ul class="EventPage__seriesLinksList">
                        {% for link in content.series_links %}
                            <li><a class="EventContentBlock__link" href="{{ link.url }}">{{ link.text }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
            {% endif %}

            {% if content.services %}
                <div class="EventContentBlock">
                    <h2 class="EventContentBlock__title">Services</h2>
                    <ul class="EventContentBlock__services">
                        {% for service in content.services %}
                            <li class="EventContentBlock__service">
                                <span class="EventContentBlock__serviceName">{{ service.name }}</span>
                                <span class="EventContentBlock__serviceAvailability EventContentBlock__serviceAvailability--{{ service.availability ? 'yes' : 'no' }}">
                                    {{ service.availability ? 'OUI' : 'NON' }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
            {% if content.regatta_informations %}
                <div class="EventContentBlock">
                    {{ content.regatta_informations|raw }}
                </div>
            {% endif %}
        {% endif %}

        {% if content.media %}
            <section class="EventPage__mediasBloc EventContentBlock">
                {{ include('partials/_media_mosaic.html.twig', {medias: content.media}, with_context: false) }}
            </section>
        {% endif %}

        {{ include('partials/_links_and_contacts.html.twig', {
            links: content.links|default(null),
            contacts: content.contact|default(null),
        }, with_context: false) }}

        {% if content.block_title or content.block_description or content.block_services or content.content_links or content.cta_text %}
            <section class="EventContentBlock">
                {% if content.block_title %}
                    <h2 class="EventContentBlock__title">{{ content.block_title }}</h2>
                {% endif %}

                {% if content.block_description %}
                    <div class="EventContentBlock__description">
                        {{ content.block_description|raw }}
                    </div>
                {% endif %}

                {% if content.block_services %}
                    <ul class="EventContentBlock__services">
                        {% for service in content.block_services %}
                            <li class="EventContentBlock__service">
                                <span class="EventContentBlock__serviceName">{{ service.name }}</span>
                                <span class="EventContentBlock__serviceAvailability EventContentBlock__serviceAvailability--{{ service.available ? 'yes' : 'no' }}">
                                    {{ service.available ? 'OUI' : 'NON' }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if content.links_title or content.content_links %}
                    <div class="EventContentBlock__linksSection">
                        {% if content.links_title %}
                            <h3 class="EventContentBlock__linksTitle">{{ content.links_title }}</h3>
                        {% endif %}
                        {% if content.content_links %}
                            <ul class="EventContentBlock__linksList">
                                {% for link in content.content_links %}
                                    <li>
                                        <a href="{{ link.url }}" class="EventContentBlock__link">{{ link.text }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                {% endif %}

                {% if content.cta_title or content.cta_text %}
                    <div class="EventContentBlock__ctaSection">
                        {% if content.cta_title %}
                            <h3 class="EventContentBlock__ctaTitle">{{ content.cta_title }}</h3>
                        {% endif %}
                        {% if content.cta_text %}
                            <a href="{{ content.cta_url|default('#') }}" class="EventContentBlock__ctaButton">
                                {{ content.cta_text }}
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </section>
        {% endif %}
    </main>
{% endblock %}
