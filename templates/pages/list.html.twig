{% extends 'pages/default.html.twig' %}

{% block pageclass 'EventListPage' %}

{% block styles %}
    <link rel="stylesheet" href="{{ asset('styles/default.css') }}" />
{% endblock %}

{% block MainContent %}

    {% set list = content.list_type == 'page' ? content.page_list : content.event_list %}
    {% set list_view = content.list_type == 'page' ? view.page_list : view.event_list %}

        <section class="ListPage__mainContent">
            <ul class="ListPage__list ListPage__list--{{ content.list_type }} SectionPadded">
                {% for item in list %}
                    <li class="ListPage__listItem">
                        <article class="ListPage__article">
                            <h2 class="ListPage__articleTitle">{{ item.title }}</h2>

                            {% if item.media %}
                                {% set media = item.media.formats is defined ? item.media : item.media[0] %}
                                <div class="ListPage__articleMedia">
                                    <img
                                        src="{{ media.formats['sulu-400x400.webp'] }}"
                                        alt="{{ media.title }}" />
                                </div>

                            {% endif %}

                            <div class="ListPage__articleDescription">
                                {{ item.description|raw }}
                            </div>

                            <a class="ListPage__moreInfoLink" href="{{ item.url }}">En savoir +</a>
                        </article>
                    </li>
                {% endfor %}
            </ul>
            {% if list_view is not empty and list_view.paginated %}
                <footer>
                    {{ include('_pager.html.twig', {content: content, list_view: list_view}, with_context: false) }}
                </footer>
            {% endif %}
        </section>
{% endblock %}
