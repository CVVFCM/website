{% extends 'base.html.twig' %}

{% block content %}
    {% set list = content.list_type == 'page' ? content.page_list : content.event_list %}
    {% set list_view = content.list_type == 'page' ? view.page_list : view.event_list %}

    <article>
        <header>
            <h1>{{ content.title }}</h1>
            {% if content.media %}
                <div>
                    <img
                        src="{{ content.media.formats['sulu-400x400.webp'] }}"
                        alt="{{ content.media.title }}"
                        title="{{ content.media.description|default(content.media.title) }}"/>
                </div>
            {% endif %}

            <div>{{ content.description|raw }}</div>
        </header>

        <section>
            <ul class="ListPage__list ListPage__list--{{ content.list_type }}">
                {% for item in list %}
                    <li>
                        <div class="ListPage__listItem">
                            <div class="HomepageCalendar__eventTitle">
                                {{ item.title }}
                            </div>

                            {% if item.media %}
                                {% set media = item.media.formats is defined ? item.media : item.media[0] %}
                                <img
                                    src="{{ media.formats['sulu-400x400.webp'] }}"
                                    alt="{{ media.title }}"/>
                            {% endif %}

                            <div class="HomepageCalendar__eventDescription">
                                {{ item.description|raw }}
                            </div>

                            <a href="{{ item.url }}">Plus d'informations</a>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </section>

        {% if list_view.paginated %}
            <footer>
                {{ include('_pager.html.twig', {content: content, list_view: list_view}, with_context: false) }}
            </footer>
        {% endif %}
    </article>
{% endblock %}
