{% extends 'pages/default.html.twig' %}

{% block pageclass 'EventListPage' %}

{% block styles %}
    <link rel="stylesheet" href="{{ asset('styles/default.css') }}" />
{% endblock %}

{% block MainContent %}

    {% set list = content.list_type == 'page' ? content.page_list : content.event_list %}
    {% set list_view = content.list_type == 'page' ? view.page_list : view.event_list %}

        <section class="ListPage__mainContent">
            {% if content.list_type == 'event' %}
                {# One download for the whole season, instead of a button per card (issue #90). #}
                <div class="ListPage__actions SectionPadded">
                    <a class="ListPage__calendarLink" href="{{ path('events_ics_feed') }}" download>
                        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Ajouter les événements à mon calendrier
                    </a>
                </div>
            {% endif %}
            <ul class="ListPage__list ListPage__list--{{ content.list_type }} SectionPadded">
                {% for item in list %}
                    <li class="ListPage__listItem">
                        {% if item.event_type is defined and item.event_type is not null %}
                            {{ include('partials/list_item_event.html.twig', {item: item}, with_context: false) }}
                        {% else %}
                            {{ include('partials/list_item_page.html.twig', {item: item}, with_context: false) }}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
            {% if list_view is not empty and list_view.paginated and list_view.maxPage > 1 %}
                <footer class="ListPage__pagerFooter">
                    {{ include('_pager.html.twig', {content: content, list_view: list_view}, with_context: false) }}
                </footer>
            {% endif %}
        </section>
{% endblock %}
