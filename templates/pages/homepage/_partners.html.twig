{% import 'partials/_picture.html.twig' as picture %}
<section class="HomepagePartners SectionPadded">
    <div class="HomepagePartners__header">
        <h2 class="HomepagePartners__title">{{ block.title }}</h2>
        {% if block.description %}
            <div class="HomepagePartners__description">{{ block.description|raw }}</div>
        {% endif %}
    </div>

    <ul class="HomepagePartners__grid">
        {% for partner in block.partners %}
            <li class="HomepagePartners__item">
                {% if partner.url %}
                    <a href="{{ partner.url }}"
                       class="HomepagePartners__link"
                       target="_blank"
                       rel="noopener"
                       title="{{ partner.name }}">
                        {{ picture.render(partner.media, 'sulu-400x400', partner.name, {
                            class: 'HomepagePartners__logo',
                            loading: 'lazy',
                            width: 400,
                            height: 400,
                        }) }}
                    </a>
                {% else %}
                    <div class="HomepagePartners__logoWrapper">
                        {{ picture.render(partner.media, 'sulu-400x400', partner.name, {
                            class: 'HomepagePartners__logo',
                            loading: 'lazy',
                            width: 400,
                            height: 400,
                        }) }}
                    </div>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</section>
