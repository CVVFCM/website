{% import 'partials/_picture.html.twig' as picture %}
<header class="Header SectionPadded">
    <div class="Header__background">
        {{ picture.render(block.header_media|default(null), '1920x', '', {
            widths: [['640x', 640], ['1024x', 1024], ['1600x', 1600], ['1920x', 1920]],
            sizes: '100vw',
            loading: 'eager',
            class: 'Header__backgroundImage',
        }) }}
    </div>

    <div class="Header__titleContainer">
        <div class="Header__logoPlaceholder" aria-label="Logo CVVFCM">
            <img src="{{ asset('images/logo_cvvfcm.svg') }}" alt="Logo CVVFCM" width="214" height="135" fetchpriority="high" />
        </div>
        <h1 class="Header__title">{{ content.title }}</h1>
    </div>

    <div class="Header__ctasContainer">
        <div class="Header__ctas">
            {% for cta in block.header_ctas %}
                <a href="{{ cta.url }}" class="CtaCard">
                    {% if cta.image is defined and cta.image %}
                        {{ picture.render(cta.image, 'sulu-400x400', '', {
                            class: 'CtaCard__image',
                            width: 400,
                            height: 400,
                        }) }}
                    {% endif %}
                    <div class="CtaCard__content">
                        <h2 class="CtaCard__title">{{ cta.title }}</h2>
                        <p class="CtaCard__description">{{ cta.description }}</p>
                        <span class="CtaCard__link">En savoir +</span>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
</header>
