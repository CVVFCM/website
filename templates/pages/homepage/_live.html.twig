<section class="HomepageLive sectionPadded">
    <header class="HomepageLive__header">
          <h2 class="HomepageLive__title">{{ block.title }}</h2>
          <div class="HomepageLive__description">{{ block.description|raw }}</div>
          <div class="HomepageLive__weatherDate">
              <span class="HomepageLive__weatherDay">{{ 'now'|date('l')|trans }}</span>
              <span class="HomepageLive__weatherDateNumber">{{ 'now'|date('d') }} {{ 'now'|date('M')|upper }}.</span>
          </div>
    </header>

    {# Wind Column #}
    <twig:WeatherLive class="HomepageLive__wind" variant="homepage-wind" />

    {# Weather Column #}
    <twig:WeatherLive class="HomepageLive__weather" variant="homepage" />

    {# Webcam Column #}
    <div class="HomepageLive__webcam">
        {% for webcam in block.webcams %}
            <div class="HomepageLive__webcamWrapper">
                <twig:Webcam url="{{ webcam.webcam_stream_url }}" link="{{ block.webcam_stream_page_link }}" />
            </div>
        {% endfor %}

        <a href="{{ block.webcam_stream_page_link.url|default('#') }}" class="HomepageLive__liveButton">
            <img src="{{ asset('images/livecam_picto.svg') }}" alt="live cam du lac des vieilles forges" />
            En direct
        </a>
    </div>
    <div class="HomepageLive__prevision">
        <h3 class="HomepageLive__previsionTitle">
            Prévisions
        </h3>
        <p class="HomepageLive__prevision-label">Matin</p>
        <p class="HomepageLive__prevision-value">
            <span class="HomepageLive__prevision-air">20 km/h SE - 22°c</span>
            <span class="HomepageLive__prevision-cloud"> Eclaircies</span>
        </p>
        <p class="HomepageLive__prevision-label">Aprem</p>
        <p class="HomepageLive__prevision-value">
            <span class="HomepageLive__prevision-air">28 km/h E - 26°c</span>
            <span class="HomepageLive__prevision-cloud"> beau</span>
        </p>
    </div>
</section>
