{% extends 'base.html.twig' %}
{% import 'partials/_picture.html.twig' as picture %}

{% block content %}
    <article>
        <header>
            <h1>{{ content.title }}</h1>

            {% if content.media %}
                {{ picture.render(content.media, 'sulu-400x400', content.media.title, {
                    loading: 'eager',
                    width: 400,
                    height: 400,
                }) }}
            {% endif %}

            <div>{{ content.description|raw }}</div>
        </header>
    </article>
{% endblock %}
