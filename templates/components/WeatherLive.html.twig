<section {{ attributes.defaults({}) }}>
    {% set liveWeather = this.liveWeather %}

    {% if liveWeather %}
        {% if this.variant == 'homepage' %}
            {# Homepage weather variant -temperature display #}

            {% set currentCondition = this.currentCondition %}

            <img class="HomepageLive__weatherIcon" src="{{ asset('images/meteo_icons/eclaircies.svg') }}" alt="météo actuelle {{ currentCondition|default('') }}" />

            <div class="HomepageLive__weatherInfo">

                <div class="HomepageLive__weatherTemp">{{ liveWeather.temperature|round(1)|replace({'.': ','}) }}<span class="HomepageLive__weatherTempUnit">°c</span></div>
                {% if currentCondition %}
                    <div class="HomepageLive__weatherCondition">{{ currentCondition }}</div>
                {% endif %}
            </div>

        {% elseif this.variant == 'homepage-wind' %}
            {# Homepage wind variant - Lake map with wind info #}

            <div class="HomepageLive__lakeMap">
                <div class="HomepageLive__pictureContainer">
                     <img class="HomepageLive__lakeShape" src="{{ asset('images/carte des vieilles forges.svg') }}" alt="carte du lac des vieilles forges" />
                </div>
                <div class="HomepageLive__compass">
                 <img class="HomepageLive__cadranPicture" src="{{ asset('images/cadran.svg') }}" alt="carte du lac des vieilles forges" />
                 <img class="HomepageLive__arrowWindPicture" src="{{ asset('images/wind arrow.svg') }}" alt="carte du lac des vieilles forges" />
                </div>

                <div class="HomepageLive__windInfo">
                    <div class="HomepageLive__windKnots">
                        <span class="HomepageLive__windKnotsValue">{{ liveWeather.windSpeed|round }}</span> Noeuds (raf.)
                    </div>
                    <div class="HomepageLive__windSpeed">
                        {{ liveWeather.windSpeed|replace({'.': ','}) }} <span class="HomepageLive__windSpeedUnit">Noeuds</span>
                    </div>
                    <div class="HomepageLive__windDirection">
                        {{ liveWeather.windDirectionAsCardinal.value }}
                    </div>
                </div>
            </div>

        {% else %}
            {# Default full variant #}
            <time datetime="{{ liveWeather.updatedAt.format('c') }}">
                Mis à jour le {{ liveWeather.updatedAt.format('d/m/Y à H:i:s') }}
            </time>

            {% if this.full %}
                <a href="{{ this.link }}">
                    Voir tous les relevés
                </a>

                <dl class="WeatherLive__humidity">
                    <dt>Humidité</dt>
                    <dd>{{ liveWeather.humidity|format_number(style: 'percent') }}</dd>
                    <dt>Humidité min</dt>
                    <dd>{{ liveWeather.humidityMin|format_number(style: 'percent') }}</dd>
                    <dt>Humidité max</dt>
                    <dd>{{ liveWeather.humidityMax|format_number(style: 'percent') }}</dd>
                </dl>

                <dl class="WeatherLive__pressure">
                    <dt>Pression atmosphérique</dt>
                    <dd>{{ liveWeather.pressure|format_number }} hPa</dd>
                    <dt>Pression atmosphérique min</dt>
                    <dd>{{ liveWeather.pressureMin|format_number }} hPa</dd>
                    <dt>Pression atmosphérique max</dt>
                    <dd>{{ liveWeather.pressureMax|format_number }} hPa</dd>
                </dl>
            {% endif %}

            <dl class="WeatherLive__temperature">
                <dt>Température</dt>
                <dd>{{ liveWeather.temperature|format_number }} °C</dd>
                <dt>Température min</dt>
                <dd>{{ liveWeather.temperatureMin|format_number }} °C</dd>
                <dt>Température max</dt>
                <dd>{{ liveWeather.temperatureMax|format_number }} °C</dd>
            </dl>

            {% if this.full %}
                <dl class="WeatherLive__rain">
                    <dt>Rythme pluie</dt>
                    <dd>{{ liveWeather.rainRate|format_number }} mm/h</dd>
                    <dt>Total pluie Aujourd'hui</dt>
                    <dd>{{ liveWeather.rainTotal|format_number }} mm</dd>
                </dl>
            {% endif %}

            <dl class="WeatherLive__currentWind">
                <dt>Direction du vent</dt>
                <dd>{{ liveWeather.windDirectionAsCardinal.value }}</dd>
                <dt>Vitesse du vent</dt>
                <dd>{{ liveWeather.windSpeed|round|format_number }} nds</dd>
                <dt>Vitesse des rafales</dt>
                <dd>{{ liveWeather.windGusts|round|format_number }} nds</dd>
            </dl>

            <dl class="WeatherLive__averageWind">
                <dt>Direction du vent moyen</dt>
                <dd>{{ liveWeather.windDirectionAverageAsCardinal.value }}</dd>
                <dt>Vitesse du vent moyen</dt>
                <dd>{{ liveWeather.windSpeedAverage|round|format_number }} nds</dd>
                <dt>Vitesse du vent min</dt>
                <dd>{{ liveWeather.windSpeedMax|round|format_number }} nds</dd>
                <dt>Vitesse du vent max</dt>
                <dd>{{ liveWeather.windSpeedMax|round|format_number }} nds</dd>
            </dl>
        {% endif %}
    {% endif %}
</section>
