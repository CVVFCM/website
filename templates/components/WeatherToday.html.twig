<div class="HomepageLive__prevision" {{ attributes }}>
    <h3 class="HomepageLive__previsionTitle">Prévisions</h3>
    {% for label, forecast in this.previsions %}
        {% if forecast %}
            <p class="HomepageLive__previsionLabel">{{ label }}</p>
            <p class="HomepageLive__previsionValue">
                <span class="HomepageLive__previsionAir">{{ forecast.windSpeed|round }} Nds {{ forecast.windCardinalDirection.name }} - {{ forecast.temperature|round }}°c</span>
                <span class="HomepageLive__previsionCloud"> {{ forecast.conditionLabel }}</span>
            </p>
        {% endif %}
    {% endfor %}
</div>
