<section {{ attributes.defaults({}) }}>
    {% set forecasts = this.data %}
    {% if forecasts|length > 0 %}
        <div>
            <h4>Aujourd'hui</h4>

            <ul>
                {% set tomorrow = false %}
                {% for forecast in forecasts %}
                    {# Close the current container and open a new one if day change #}
                    {% if not tomorrow and forecast.date.format('Y-m-d') != date().format('Y-m-d') %}
                        {% set tomorrow = true %}
            </ul>
        </div>

        <div>
            <h4>Demain</h4>

            <ul>
                    {% endif %}

                    <li>
                        <strong>{{ forecast.label }}</strong>
                        <span>{{ forecast.temperature|round }}°C</span>
                        <span>{{ forecast.windSpeed|round }}nds</span>
                        <span>{{ forecast.windCardinalDirection.value }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
</section>
