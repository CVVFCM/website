{% types {
    content: 'array',
    title: 'string',
    links: 'array',
} %}

{% if content.links is defined and content.links is not empty %}
    <ul class="NavigationLinks__list" aria-label="{{ content.title }}">
        {# Map the snake_case display enum (content data) to camelCase BEM modifiers. #}
        {% set display_class_map = {header_top: 'headerTop', header_right: 'headerRight', hidden_text: 'hiddenText'} %}
        {% for link in content.links %}
            {% set display_modifier = '' %}
            {% set is_header_positioned = false %}
            {% if link.display is defined and link.display %}
                {% for display_value in link.display %}
                    {% set display_modifier = display_modifier ~ ' NavigationLinks__item--' ~ (display_class_map[display_value] ?? display_value) %}
                    {% if display_value in ['header_top', 'header_right'] %}
                        {% set is_header_positioned = true %}
                    {% endif %}
                {% endfor %}
            {% endif %}
            {% if not is_header_positioned %}
                {% set display_modifier = display_modifier ~ ' NavigationLinks__item--menuOnly' %}
            {% endif %}
            <li class="NavigationLinks__item{{ display_modifier }}">
                {% if link.type == 'internal' and link.page is defined %}
                    <a class="NavigationLinks__link"
                       href="{{ sulu_content_path(link.page.url) }}"
                       title="{{ link.label }}">
                        {% if link.media is defined and link.media %}
                            <span
                                class="NavigationLinks__media"
                                style="--nav-icon-mask: url('{{ link.media.thumbnails['x800'] }}');"
                                aria-hidden="true"></span>
                        {% endif %}
                        <span class="NavigationLinks__label">{{ link.label }}</span>
                    </a>
                {% elseif link.type == 'external' and link.url is defined %}
                    <a class="NavigationLinks__link"
                       href="{{ link.url }}"
                       title="{{ link.label }}"
                       target="_blank"
                       rel="noopener noreferrer">
                        {% if link.media is defined and link.media %}
                            <span class="NavigationLinks__media"
                                style="--nav-icon-mask: url('{{ link.media.thumbnails['x800'] }}');"
                                aria-hidden="true"></span>
                        {% endif %}
                        <span class="NavigationLinks__label">{{ link.label }}</span>
                    </a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
