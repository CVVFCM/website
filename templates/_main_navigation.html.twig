{% set navigation_context_name = 'main' %}
{% set navigation_max_depth = 4 %}

{% set navigation_root = sulu_page_navigation_root_tree(navigation_context_name, navigation_max_depth, {title: 'title', url: 'url', template: 'object.templateKey', uuid: 'object.resource.uuid'}) %}
{% set navigation_links = sulu_snippet_load_by_area('navigation_links') %}

<nav class="MainNavigation"
     aria-label="Navigation principale"
     data-controller="main-navigation"
     data-action="keydown.esc->main-navigation#closeOnEscape">

    <div class="MainNavigation__bar">
        <a class="MainNavigation__logo" href="{{ sulu_content_root_path() }}" aria-label="Accueil CVVFCM">
            <img src="{{ asset('images/logo_cvvfcm_color.svg') }}" alt="" width="189" height="121" />
            {{ include('partials/logo_wordmark.html.twig', {class: 'MainNavigation__wordmark'}) }}
        </a>

        {% if navigation_links %}
            {{ include('snippets/navigation_links.html.twig', {content: navigation_links.content, variant: 'bar'}) }}
        {% endif %}

        <div class="MainNavigation__mainTools">
            <a class="MainNavigation__searchToggle"
               href="#searcBar"
               aria-label="Rechercher">
                <span class="MainNavigation__searchIcon" aria-hidden="true"></span>
            </a>
            <button class="MainNavigation__toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls="main-navigation-menu"
                    aria-label="Ouvrir le menu de navigation"
                    data-main-navigation-target="toggle"
                    data-action="main-navigation#toggle">
                <span class="MainNavigation__burger" aria-hidden="true"></span>
            </button>
        </div>
    </div>

    <div class="MainNavigation__container"
         id="main-navigation-menu"
         data-main-navigation-target="menu">

        {% if navigation_links %}
            <div class="MainNavigation__quickActions">
                {{ include('snippets/navigation_links.html.twig', {content: navigation_links.content, variant: 'grid'}) }}
            </div>
        {% endif %}

        <ul class="MainNavigation__list">
            {% if navigation_root %}
                {{ _self.display_navigation_nodes(navigation_root|first, 0, app.request.pathinfo) }}
            {% endif %}
        </ul>
    </div>
</nav>

{% macro is_active_subtree(item, currentPath) %}
    {% set itemPath = item.url is not empty ? sulu_content_path(item.url) : null %}
    {% if itemPath is not null and (currentPath == itemPath or currentPath starts with (itemPath ~ '/')) %}
        true
    {% else %}
        {% for child in item.children %}
            {% if _self.is_active_subtree(child, currentPath)|trim == 'true' %}true{% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% macro display_navigation_nodes(root, depth, currentPath) %}
    {% set depth = depth|default(0) %}
    {% for item in root.children %}
        {% set itemPath = item.url is not empty ? sulu_content_path(item.url) : null %}
        {% set isAncestor = itemPath is not null and (currentPath == itemPath or currentPath starts with (itemPath ~ '/')) %}
        {% if not isAncestor and item.children is not empty %}
            {% set isAncestor = _self.is_active_subtree(item, currentPath)|trim == 'true' %}
        {% endif %}

        {% set liClass = item.template == 'category' ? 'MainNavigation__item--category' : '' %}
        {% set liClass = isAncestor ? (liClass ~ ' MainNavigation__item--ancestor')|trim : liClass %}

        <li{% if liClass %} class="{{ liClass }}"{% endif %}>
            {% if item.template == 'category' %}
                {# Category pages 404 on the website: link to their first page instead. #}
                {% set categoryFirstPageUrl = category_first_page_url(item.uuid|default(null)) %}
                {% if categoryFirstPageUrl %}
                    <a class="MainNavigation__link{{ isAncestor ? ' MainNavigation__link--ancestor' : '' }}"
                       href="{{ sulu_content_path(categoryFirstPageUrl) }}"
                       title="{{ item.title }}"><span class="MainNavigation__linkText">{{ item.title }}</span></a>
                {% else %}
                    <span class="MainNavigation__link"
                          title="{{ item.title }}"><span class="MainNavigation__linkText">{{ item.title }}</span></span>
                {% endif %}
            {% else %}
                <a class="MainNavigation__link{{ isAncestor ? ' MainNavigation__link--ancestor' : '' }}" href="{{ sulu_content_path(item.url) }}" title="{{ item.title }}"><span class="MainNavigation__linkText">{{ item.title }}</span></a>
            {% endif %}

            {% if depth == 0 and item.children is not empty %}
                <button class="MainNavigation__sectionToggle"
                        type="button"
                        aria-expanded="false"
                        aria-controls="nav-section-{{ item.uuid }}"
                        aria-label="Déplier {{ item.title }}"
                        data-action="main-navigation#toggleSection"></button>
            {% endif %}

            {% if item.children is not empty %}
                <ul{% if depth == 0 %} id="nav-section-{{ item.uuid }}"{% endif %}>
                    {{ _self.display_navigation_nodes(item, depth + 1, currentPath) }}
                </ul>
            {% endif %}
        </li>
    {% endfor %}
{% endmacro %}
