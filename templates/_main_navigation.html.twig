{% set navigation_context_name = 'main' %}
{% set navigation_max_depth = 3 %}

{% set navigation_root = sulu_page_navigation_root_tree(navigation_context_name, navigation_max_depth) %}
{% set navigation_links = sulu_snippet_load_by_area('navigation_links') %}

<nav class="MainNavigation"
     aria-label="Navigation principale"
     data-controller="main-navigation"
     data-action="keydown.esc->main-navigation#closeOnEscape">
    <button class="MainNavigation__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="main-navigation-menu"
            aria-label="Ouvrir le menu de navigation"
            data-main-navigation-target="toggle"
            data-action="click->main-navigation#toggle">
        Menu
    </button>
    <div class="MainNavigation__container"
         id="main-navigation-menu"
         data-main-navigation-target="menu">
        <ul class="MainNavigation__list">
            <li>
                <a class="MainNavigation__link" href="{{ sulu_content_root_path() }}">Homepage</a>
            </li>

            {% if navigation_root %}
                {{ _self.display_navigation_nodes(navigation_root|first) }}
            {% endif %}

        </ul>

        {% if navigation_links %}
            {% include 'snippets/navigation_links.html.twig' with {content: navigation_links.content} %}
        {% endif %}
    </div>
</nav>

{% macro display_navigation_nodes(root) %}
    {% for item in root.children %}
        <li>
            <a class="MainNavigation__link" href="{{ sulu_content_path(item.url) }}" title="{{ item.title }}">
                {{ item.title }}
            </a>

            {% if item.children is not empty %}
                <ul>
                    {{ _self.display_navigation_nodes(item) }}
                </ul>
            {% endif %}
        </li>
    {% endfor %}
{% endmacro %}
