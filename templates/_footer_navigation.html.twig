{% set navigation_context_name = 'footer' %}
{% set navigation_max_depth = 1 %}

{% set navigation_root = sulu_page_navigation_root_tree(navigation_context_name, navigation_max_depth) %}

<nav>
    <ul>
        {{ _self.display_navigation_nodes(navigation_root) }}
    </ul>
</nav>

{% macro display_navigation_nodes(root) %}
    {% for item in root is iterable ? root : root.children %}
        <li>
            <a href="{{ sulu_content_path(item.url) }}" title="{{ item.title }}">
                {{ item.title }}
            </a>

            {% if item.children is not empty %}
                <ul>
                    {{ _self.display_navigation_nodes(item) }}
                </ul>
            {% endif %}
        </li>
    {% endfor %}
{% endmacro %}
